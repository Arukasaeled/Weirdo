{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Weirdo",
  "version": "0.2.1",
  "identifier": "app.weirdo.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix web run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Weirdo contributors",
    "category": "DeveloperTool",
    "shortDescription": "Native multi-Agent terminal workbench",
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": {
      "../dist/native-broker/Weirdo.Broker.exe": "Weirdo.Broker.exe",
      "../LICENSE": "LICENSE",
      "../NOTICE.md": "NOTICE.md",
      "../licenses/": "licenses/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../installer/nsis-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "startMenuFolder": "Weirdo"
      }
    }
  }
}
