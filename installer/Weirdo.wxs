<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Weirdo for Windows" Manufacturer="Weirdo Windows contributors" Version="$(var.AppVersion)" UpgradeCode="2ddc2b1c-4cf7-49f3-90f0-9bd2989f668c" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Weirdo is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="WeirdoIcon" SourceFile="src-tauri\icons\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="WeirdoIcon" />
    <StandardDirectory Id="LocalAppDataFolder"><Directory Id="ProgramsFolder" Name="Programs"><Directory Id="INSTALLFOLDER" Name="Weirdo" /></Directory></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="WeirdoMenu" Name="Weirdo" /></StandardDirectory>
    <Feature Id="Main" Title="Weirdo" Level="1"><ComponentGroupRef Id="AppFiles" /><ComponentRef Id="StartMenuShortcut" /></Feature>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER"><Files Include="$(var.PublishDir)\**" /></ComponentGroup>
    <DirectoryRef Id="WeirdoMenu"><Component Id="StartMenuShortcut" Guid="88ac085d-04be-459c-a221-cf152383b883">
      <Shortcut Id="LaunchWeirdo" Name="Weirdo" Target="[INSTALLFOLDER]Weirdo.exe" WorkingDirectory="INSTALLFOLDER" Description="Native multi-Agent terminal workbench" Icon="WeirdoIcon" />
      <RemoveFolder Id="RemoveWeirdoMenu" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Weirdo\Windows" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component></DirectoryRef>
  </Package>
</Wix>
