<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Kooky for Windows" Manufacturer="Kooky Windows contributors" Version="$(var.AppVersion)" UpgradeCode="2ddc2b1c-4cf7-49f3-90f0-9bd2989f668c" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Kooky is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <StandardDirectory Id="LocalAppDataFolder"><Directory Id="ProgramsFolder" Name="Programs"><Directory Id="INSTALLFOLDER" Name="Kooky" /></Directory></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="KookyMenu" Name="Kooky" /></StandardDirectory>
    <Feature Id="Main" Title="Kooky" Level="1"><ComponentGroupRef Id="AppFiles" /><ComponentRef Id="StartMenuShortcut" /></Feature>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER"><Files Include="$(var.PublishDir)\**" /></ComponentGroup>
    <DirectoryRef Id="KookyMenu"><Component Id="StartMenuShortcut" Guid="88ac085d-04be-459c-a221-cf152383b883">
      <Shortcut Id="LaunchKooky" Name="Kooky" Target="[INSTALLFOLDER]Kooky.exe" WorkingDirectory="INSTALLFOLDER" Description="Native multi-Agent terminal workbench" />
      <RemoveFolder Id="RemoveKookyMenu" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Kooky\Windows" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component></DirectoryRef>
  </Package>
</Wix>
